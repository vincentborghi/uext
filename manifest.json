{
  "manifest_version": 3,
  "name": "SwissKnife Companion",
  "version": "1.0.0",
  "description": "Multi-tool companion for Music tracking (FIP & custom), BnF remote access, and Calendar events extraction.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.radiofrance.fr/*",
    "https://www.radiofrance.fr/*",
    "https://openapi.radiofrance.fr/*",
    "https://acces-distant.bnf.fr/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SwissKnife Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
